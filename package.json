{
  "name": "dsh-sidebar-left-split",
  "version": "0.1.0",
  "description": "Resizable splitter between the sidebar workspace list and the global panel nav: drag the seam to resize, and the panel nav gains a scrollbar when it shrinks.",
  "type": "module",
  "license": "MIT",
  "author": "yhPrime",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "workspace",
    "splitter",
    "resize"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhPrime/dsh-sidebar-left-split.git"
  },
  "homepage": "https://github.com/yhPrime/dsh-sidebar-left-split#readme",
  "bugs": {
    "url": "https://github.com/yhPrime/dsh-sidebar-left-split/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/check.mjs && node test/client.test.mjs"
  }
}
